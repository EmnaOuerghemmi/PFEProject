# Configuration de l'APPLICATION, sur le serveur : deploy/backend.env
# Copier ce fichier en backend.env et le compléter. Ne jamais le versionner.
# Liste complète des réglages : backend/.env.example et backend/app/core/config.py.
# DATABASE_URL et REDIS_URL sont construits par docker-compose.prod.yml.

# Clé de signature des jetons : longue et aléatoire, propre à chaque environnement.
#   openssl rand -hex 64
SECRET_KEY=

# Adresse publique de l'application (liens des e-mails : contrats, entretiens).
FRONTEND_BASE_URL=https://piqbit.example.tn
# Même origine que l'API (nginx) : aucune origine supplémentaire à autoriser.
ALLOWED_ORIGINS=
ALLOW_LOCALHOST_ORIGINS=false

# Premier compte administrateur, créé au premier démarrage s'il n'existe pas.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# E-mails sortants (contrats, invitations, refus). Vide : les e-mails sont
# seulement journalisés, rien n'est envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=PIQBIT

# Google (connexion, Meet) — facultatif.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=https://piqbit.example.tn/api/v1/interview/google-meet/callback
GOOGLE_MEET_POST_AUTH_REDIRECT=https://piqbit.example.tn/admin/interviews

LOG_LEVEL=INFO
