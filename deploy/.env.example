# Variables de la PILE (docker compose), sur le serveur : deploy/.env
# Copier ce fichier en .env et le compléter. Ne jamais le versionner.

# Registre des images, en minuscules (GHCR impose les minuscules).
IMAGE_REGISTRY=ghcr.io/emnaouerghemmi

# Base de données. Mot de passe long et aléatoire, SANS caractères spéciaux
# d'URL (@ : / ? # %), car il entre dans DATABASE_URL. Par exemple :
#   openssl rand -hex 32
POSTGRES_USER=piqbit
POSTGRES_PASSWORD=
POSTGRES_DB=piqbit

# Où publier le frontend (nginx). « 80 » : toutes les interfaces.
# « 127.0.0.1:8080 » : la machine seule, derrière un proxy TLS.
HTTP_BIND=80

# Adresse locale que deploy.sh interroge pour vérifier la mise en ligne
# (doit correspondre à HTTP_BIND).
SMOKE_URL=http://127.0.0.1:80

# Sauvegardes de la base conservées avant migration.
BACKUPS_TO_KEEP=10
