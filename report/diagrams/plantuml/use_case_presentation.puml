@startuml PIQBIT-CasUtilisation-Presentation
' ============================================================================
' PIQBIT — Cas d'utilisation, VERSION PRÉSENTATION (16:9)
'
' Variante compacte de use_case_global.puml, pensée pour être projetée :
'   - 16 cas au lieu de 21 (fusion des capacités voisines) ;
'   - trois blocs qui forcent le regroupement et suppriment les vides ;
'   - acteurs répartis à GAUCHE (externes) et à DROITE (internes) ;
'   - aucune note flottante : l'information passe par des stéréotypes
'     «sans compte» et «IA», qui tiennent dans la forme et ne créent
'     aucun trait supplémentaire.
'
' Astuce de mise en page : en `left to right direction`, un acteur écrit
' AVANT le cas se place à gauche (`Acteur -- UC`), après il se place à
' droite (`UC -- Acteur`). L'association acteur/cas est volontairement non
' orientée : c'est la notation UML correcte, et elle sert ici de levier
' de placement.
' ============================================================================

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #06222A
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam nodesep 14
skinparam ranksep 45
skinparam actor {
  BorderColor #3D4F4F
  BackgroundColor #FFFFFF
  FontColor #1B2B2B
  FontSize 14
  FontStyle bold
}
skinparam usecase {
  BorderColor #06222A
  BackgroundColor #E7EEF0
  FontColor #06222A
  FontSize 13
  BorderThickness 1
}
skinparam rectangle {
  BorderColor #06222A
  FontColor #06222A
  FontStyle bold
  FontSize 14
}

' ─── Acteurs externes (colonne de gauche) ──────────────────────────────────
actor "Visiteur" as Visiteur
actor "Candidat" as Candidat

rectangle "PIQBIT" {

  rectangle "Espace candidat" as B1 #FDFEFE {
    usecase "Consulter\nles offres"              as UC01
    usecase "Postuler\nà une offre"              as UC02
    usecase "Suivre sa\ncandidature"             as UC03
    usecase "Confirmer un créneau\n«sans compte»" as UC04
    usecase "Passer le test technique\n«sans compte»" as UC05
    usecase "Signer le contrat\n«sans compte»"   as UC06
  }

  rectangle "Évaluation et entretiens" as B2 #FDFEFE {
    usecase "Analyser et noter\nle CV  «IA»"         as UC07
    usecase "Classer et rechercher\nles profils  «IA»" as UC08
    usecase "Planifier et évaluer\nles entretiens"   as UC09
    usecase "Interroger\nl'assistant  «IA»"          as UC10
  }

  rectangle "Embauche et pilotage" as B3 #FDFEFE {
    usecase "Gérer les offres\nd'emploi"       as UC11
    usecase "Décider\nde l'embauche  «IA»"     as UC12
    usecase "Négocier\nle salaire  «IA»"       as UC13
    usecase "Éditer et envoyer\nle contrat"    as UC14
    usecase "Piloter l'activité RH\net le budget" as UC15
    usecase "Administrer\ncomptes et rôles"    as UC16
  }
}

' ─── Acteurs internes (colonne de droite) ──────────────────────────────────
actor "Recruteur"      as Recruteur
actor "Responsable RH" as RH
actor "Administrateur" as Admin

' ─── Généralisations ───────────────────────────────────────────────────────
' Test de substitution : partout où le système attend le parent, l'enfant
' peut-il se substituer sans choquer ? Oui pour ces deux-là. Non pour
' l'administrateur, acteur technique qui n'a pas à décider d'une embauche —
' d'où l'absence de `RH <|-- Admin`.
Visiteur  <|-- Candidat
Recruteur <|-- RH

' ─── Associations : acteur à gauche ────────────────────────────────────────
Visiteur -- UC01
Candidat -- UC02
Candidat -- UC03
Candidat -- UC04
Candidat -- UC05
Candidat -- UC06

' ─── Associations : acteur à droite ────────────────────────────────────────
UC08 -- Recruteur
UC09 -- Recruteur
UC10 -- Recruteur

UC11 -- RH
UC12 -- RH
UC13 -- RH
UC14 -- RH
UC15 -- RH

UC16 -- Admin

' ─── Relation entre cas ────────────────────────────────────────────────────
UC02 ..> UC07 : <<include>>

@enduml
