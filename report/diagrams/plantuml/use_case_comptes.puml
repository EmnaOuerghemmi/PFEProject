@startuml PIQBIT-CasUtilisation-Comptes
' ============================================================================
' Module 1 — Comptes, authentification et autorisation
' Exigences couvertes : FR-AUTH-01..05, FR-ACC-01..05
' ============================================================================

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #06222A
skinparam actorStyle awesome
skinparam actor {
  BorderColor #3D4F4F
  BackgroundColor #FFFFFF
  FontColor #1B2B2B
}
skinparam usecase {
  BorderColor #06222A
  BackgroundColor #E7EEF0
  FontColor #06222A
  BorderThickness 1
}
skinparam rectangle {
  BorderColor #06222A
  FontColor #06222A
  FontStyle bold
}

actor "Visiteur"       as Visiteur
actor "Utilisateur"    as User
actor "Administrateur" as Admin

rectangle "Comptes et accès" {
  usecase "S'inscrire"                         as UC01
  usecase "Vérifier son adresse"               as UC02
  usecase "Se connecter"                       as UC03
  usecase "Se connecter par\nidentité externe" as UC04
  usecase "Activer le second\nfacteur (2FA)"   as UC05
  usecase "Valider le code\nà usage unique"    as UC06
  usecase "Réinitialiser son\nmot de passe"    as UC07
  usecase "Modifier son profil\net sa photo"   as UC08
  usecase "Supprimer son compte"               as UC09
  usecase "Créer un compte\ninterne"           as UC10
  usecase "Attribuer un rôle"                  as UC11
  usecase "Désactiver un compte"               as UC12
  usecase "Consulter le\njournal d'audit"      as UC13
}

Visiteur --> UC01
Visiteur --> UC02
Visiteur --> UC03
Visiteur --> UC04
Visiteur --> UC07

User --> UC05
User --> UC08
User --> UC09

Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13

UC03 ..> UC06 : <<extend>>
UC05 ..> UC06 : <<include>>

note bottom of UC03
  Le temps de réponse est **égalisé** :
  un hachage factice est calculé pour
  une adresse inconnue, afin de ne pas
  révéler quels comptes existent.
end note

note bottom of UC06
  Les tentatives sont plafonnées
  **par compte** et non par adresse
  réseau : un plafond par IP se
  contourne en changeant de source.
end note

@enduml
