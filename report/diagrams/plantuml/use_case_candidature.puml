@startuml PIQBIT-CasUtilisation-Candidature
' ============================================================================
' Module 2 — Offres et candidatures
' Exigences couvertes : FR-OFF-01..05, FR-CAND-01..07
' ============================================================================

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #06222A
skinparam actorStyle awesome
skinparam actor {
  BorderColor #3D4F4F
  BackgroundColor #FFFFFF
  FontColor #1B2B2B
}
skinparam usecase {
  BorderColor #06222A
  BackgroundColor #E7EEF0
  FontColor #06222A
  BorderThickness 1
}
skinparam rectangle {
  BorderColor #06222A
  FontColor #06222A
  FontStyle bold
}

actor "Visiteur"       as Visiteur
actor "Candidat"       as Candidat
actor "Responsable RH" as RH

rectangle "Offres et candidatures" {
  usecase "Consulter le catalogue\ndes offres"    as UC01
  usecase "Rechercher et filtrer\nles offres"     as UC02
  usecase "Consulter le détail\nd'une offre"      as UC03
  usecase "Enregistrer une offre\nen favori"      as UC04
  usecase "Déposer un CV\nde référence"           as UC05
  usecase "Postuler à une offre"                  as UC06
  usecase "Contrôler le fichier\ndéposé"          as UC07
  usecase "Suivre le statut de\nses candidatures" as UC08
  usecase "Consulter l'analyse\nde son CV"        as UC09
  usecase "Retirer une candidature"               as UC10
  usecase "Créer une offre"                       as UC11
  usecase "Publier ou dépublier\nune offre"       as UC12
  usecase "Définir les compétences\nrequises"     as UC13
  usecase "Consulter les candidatures\nreçues"    as UC14
}

Visiteur --> UC01
Visiteur --> UC02
Visiteur --> UC03

Candidat --> UC04
Candidat --> UC05
Candidat --> UC06
Candidat --> UC08
Candidat --> UC09
Candidat --> UC10

RH --> UC11
RH --> UC12
RH --> UC13
RH --> UC14

UC06 ..> UC07 : <<include>>
UC11 ..> UC13 : <<include>>

note bottom of UC07
  Liste blanche de types et plafond
  de 5 Mo, appliqués **côté serveur**
  avant tout traitement.
end note

note bottom of UC10
  Le retrait déclenche la suppression
  du fichier : un CV orphelin serait
  une exposition durable de données
  personnelles.
end note

@enduml
