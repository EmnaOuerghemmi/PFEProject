# Copy to .env and fill in values

# App
APP_NAME=PIQBIT API
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-secret

# Database (use asyncpg driver for async)
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5434/piqbit

# Redis
REDIS_URL=redis://localhost:6379

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Bcrypt
BCRYPT_ROUNDS=12

# Brute-force
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# 2FA
TOTP_ISSUER=PIQBIT

# ─── Compte superadmin ──────────────────────────────────────────────────────
# Créé au démarrage s'il n'existe pas encore. Ces valeurs étaient auparavant
# écrites en dur dans app/main.py, donc committées dans Git : elles vivent
# désormais ici uniquement. Sans SUPERADMIN_EMAIL et SUPERADMIN_PASSWORD, le
# compte n'est tout simplement pas créé.
# Le mot de passe doit respecter la politique : 8 caractères minimum, une
# majuscule, une minuscule, un chiffre et un caractère spécial.
SUPERADMIN_EMAIL=admin@piqbit.tn
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-moi-Avant-Deploiement.1

# Exiger une adresse e-mail vérifiée pour se connecter. Ne passer à true
# qu'une fois l'envoi SMTP opérationnel : sinon tous les comptes déjà créés se
# retrouvent bloqués.
REQUIRE_EMAIL_VERIFICATION=false

# Racine du frontend — sert à bâtir les liens de vérification d'adresse et de
# réinitialisation de mot de passe envoyés par e-mail.
FRONTEND_BASE_URL=http://localhost:4200

# Email (SMTP — vérification de compte & réinitialisation de mot de passe)
# Laisser SMTP_HOST/SMTP_USER vides en développement : les e-mails sont alors
# seulement journalisés, l'application continue de fonctionner.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
# Gmail : générer un « mot de passe d'application », JAMAIS le mot de passe du
# compte. Ne jamais committer la valeur réelle — elle vit dans .env seulement.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAILS_FROM_EMAIL=votre-adresse@gmail.com
EMAILS_FROM_NAME=PIQBIT

# ─── CORS ───────────────────────────────────────────────────────────────────
# Domaines du frontend autorisés à appeler l'API, séparés par des virgules.
# Développement :
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
# Production, par exemple :
#   ALLOWED_ORIGINS=https://app.piqbit.tn,https://admin.piqbit.tn

# Tolère tout port localhost (previews Angular). IMPÉRATIVEMENT false en
# production, sinon la liste ci-dessus perd son rôle de garde-fou.
ALLOW_LOCALHOST_ORIGINS=true

# ─── Lien visio des entretiens ──────────────────────────────────────────────
# Rappel « rejoindre maintenant » envoyé ce nombre de minutes avant l'heure de
# l'entretien confirmé, au candidat + RH + superadmin.
INTERVIEW_MEET_REMINDER_MINUTES=8
# Base des salles Jitsi Meet (repli quand Google Meet n'est pas disponible).
# Remplacer par l'URL d'une instance Jitsi auto-hébergée si besoin.
INTERVIEW_MEET_JITSI_BASE=https://meet.jit.si
# false = aucun repli : sans Google Meet configuré, l'entretien n'a pas de lien.
INTERVIEW_MEET_FALLBACK_ENABLED=true

# Google Calendar (optionnel) — sync des entretiens + génération du lien Meet.
# Sans ces variables, le lien visio retombe sur Jitsi (voir ci-dessus).
# Un VRAI lien Google Meet exige Workspace + délégation domaine sur le compte
# de service, et GOOGLE_CALENDAR_IMPERSONATE renseigné.
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_IMPERSONATE=
GOOGLE_CALENDAR_TIMEZONE=Africa/Tunis

# ─── Embeddings / matching sémantique ────────────────────────────────────────
# "auto" = sentence-transformers si disponible, repli hash sinon.
EMBEDDINGS_BACKEND=auto
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# Jeton Hugging Face — FACULTATIF. Le modèle ci-dessus est public : le laisser
# vide fonctionne. Un jeton relève seulement les quotas de téléchargement et
# donne accès aux dépôts privés. Ne jamais commiter une valeur ici.
HF_TOKEN=

# Niveau de log de l'application (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# ─── Test technique ───────────────────────────────────────────────────────────
# Score de CV minimal pour proposer un test technique à un candidat.
TEST_ELIGIBILITY_MIN_SCORE=50
GEMINI_MODEL=gemini-3.5-flash-lite
