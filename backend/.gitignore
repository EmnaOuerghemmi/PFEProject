# Secrets
.env
*.json

# Google credentials
google-calendar-sa.json
__pycache__/
node_modules/
.vscode/
*.pyc

# Base SQLite transitoire des tests — réécrite à chaque exécution de pytest,
# elle polluait les diffs en apparaissant modifiée en permanence.
test.db

# Sauvegardes locales (dumps PostgreSQL, bundles git) : volumineuses et
# contenant des données réelles, elles n'ont rien à faire dans le dépôt.
backups/

# CV déposés par les candidats — données personnelles réelles.
# Le dépôt est distant : y pousser des CV les exposerait durablement, y compris
# après suppression du compte concerné. Le répertoire est recréé à l'upload.
uploads/

# Base SQLite des tests : un fichier par PROCESSUS pytest (test_<pid>.db),
# la règle `test.db` seule les laissait tous passer.
test_*.db
test_*.db-journal

# Détecteur de CV : les données d'entraînement sont de VRAIS CV, donc des
# données personnelles. Seul le modèle entraîné (cv_detector/models/) est
# versionné : son vocabulaire écarte les termes vus dans un seul document
# (noms, coordonnées), et les coordonnées sont masquées avant l'apprentissage.
cv_detector/dataset/
cv_detector/dataset.csv
# `*.json` ci-dessus vise les clés de compte de service ; les métadonnées du
# modèle (date d'entraînement, métriques, seuils) n'en sont pas une.
!cv_detector/models/metadata.json

# Données locales, jamais versionnées :
# - photos de profil téléversées (données personnelles) ;
static/avatars/
# - CV du jeu d'entraînement du détecteur (données personnelles). Le code
#   d'entraînement et les modèles produits, eux, sont versionnés.
cv_detector/dataset/
cv_detector/dataset.csv

# Rapports produits par les tests et la CI
.coverage
coverage.xml
junit.xml
.ruff_cache/
